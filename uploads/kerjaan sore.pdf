/Smsproject/
SELECT param1 FROM wa_data LEFT JOIN wa_bulk_dr ON wa_data.wa_id = wa_bulk_dr.messageid 
WHERE wa_bulk_dr.status = 'failed' 
AND wa_data.created_date = CURDATE() 
AND template_name = 'redaksi_waofficial20263' AND source_sms = 'SMS PROJECT'

/nondc/
SELECT param1 FROM wa_data LEFT JOIN wa_bulk_dr ON wa_data.wa_id = wa_bulk_dr.messageid 
WHERE wa_bulk_dr.status = 'failed' 
AND wa_data.created_date = CURDATE() 
AND template_name = 'redaksi_waofficial20263' AND source_sms = 'SMS Non DC'


